# Copy to .env.local. Empty values mean provider access is not configured.
# Never commit real secrets or include .env.local in agent checkpoints.
FIRMS_MAP_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public browser key; restrict to your application domains in CARTO.
NEXT_PUBLIC_CARTO_API_KEY=

# Public endpoint is for eligible noncommercial use. Configure an appropriate
# customer endpoint/key if this project's usage requires it.
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com
OPEN_METEO_API_KEY=

# Deployments must configure a persistent/hosting rate limiter (M0 access gate).
RATE_LIMIT_PROVIDER=

# Persistent limiter: use a unique random secret of at least 32 characters.
# Production requires persistent limiter + R2 + trusted Vercel IP identity.
RATE_LIMIT_SECRET=
# Set the actual agreed daily upstream budget before production. No production default.
AIR_UPSTREAM_REQUESTS_PER_DAY=
